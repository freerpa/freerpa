VITE_DEV_URL=http://localhost:3000/api
# VITE_DEV_URL=https://api.automan.site
VITE_PROD_URL=https://freerpa.cn/api
# 扩展市场地址（嵌入客户端首页；带 embed=1 启用无头模式）
# VITE_MARKET_URL=http://localhost:3000/plugins?embed=1
VITE_MARKET_URL=https://freerpa.cn/plugins?embed=1
# 下载地址（官网首页下载区）：「立即更新」跳转的 URL（仅用于下载跳转）
# VITE_DOWNLOAD_URL=http://localhost:3000/#download
VITE_DOWNLOAD_URL=https://freerpa.cn/#download
# 版本检测复用 VITE_DEV_URL / VITE_PROD_URL（/api/version/latest?platform= 返回最新版本）
