{
  "name": "FreeRPA",
  "version": "1.0.0",
  "description": "FreeRPA 风影RPA",
  "main": "./out/main/index.js",
  "author": "Auto Studio",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --inspect=9229",
    "build": "electron-vite build",
    "fetch:deno": "node scripts/fetch-deno.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "ensure:native": "node scripts/ensure-native.mjs",
    "test:worker": "node scripts/deno-smoke.mjs",
    "test:worker-permissions": "node scripts/deno-permission-test.mjs",
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/ensure-native.mjs && electron-builder install-app-deps",
    "build:unpack": "npm run ensure:native && npm run fetch:deno && npm run build:worker && npm run build && electron-builder --dir",
    "build:win": "npm run ensure:native && npm run fetch:deno && npm run build:worker && npm run build && electron-builder --win",
    "build:mac": "npm run ensure:native && npm run fetch:deno && npm run build:worker && npm run build && electron-builder --mac",
    "build:linux": "npm run ensure:native && npm run fetch:deno && npm run build:worker && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai-compatible": "^3.0.27",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.58",
    "axios": "^1.19.0",
    "croner": "^10.0.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.4.0",
    "h3": "^2.0.1-rc.26",
    "https-proxy-agent": "^9.1.0",
    "iconv-lite": "^0.7.2",
    "lodash-es": "^4.18.1",
    "mime-types": "^3.0.2",
    "pako": "^3.0.1",
    "puppeteer-core": "^25.4.0",
    "sharp": "^0.35.3",
    "socks-proxy-agent": "^10.1.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.0",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@arco-themes/vue-xavier": "^0.0.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@electron-toolkit/eslint-config": "^2.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@remixicon/vue": "^4.9.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.46.0",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.0",
    "@vueuse/core": "^14.4.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsondiffpatch": "^0.7.6",
    "less": "^4.8.1",
    "md-editor-v3": "^6.5.5",
    "node-gyp": "^12.4.0",
    "pinia": "^4.0.2",
    "pinyin": "^4.0.0",
    "prettier": "^3.9.6",
